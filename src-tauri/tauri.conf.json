{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vantage",
  "version": "0.1.0",
  "identifier": "com.pmapp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "node scripts/build-tauri.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vantage",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost blob:; img-src 'self' data: blob:; font-src 'self';"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["vantage"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first product management platform",
    "longDescription": "Vantage — plan, schedule, and export product visions from a single local vision tree."
  }
}
