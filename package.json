{
  "name": "vantage-pm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "vite --mode qualification",
    "build": "vite build --mode production",
    "build:web:staging": "node scripts/build-web.mjs staging",
    "build:web:prod": "node scripts/build-web.mjs production",
    "preview": "vite preview --mode production",
    "start": "vite build --mode production && vite preview --mode production --open",
    "build:spike": "vite build --mode production --config spikes/phase-0-durability/vite.config.ts",
    "build:qualification": "vite build --mode qualification --config spikes/phase-0-durability/vite.config.ts",
    "dev:spike": "vite --mode qualification --config spikes/phase-0-durability/vite.config.ts",
    "dev:tauri": "vite --mode tauri",
    "build:tauri": "vite build --mode tauri",
    "build:tauri:qualification": "vite build --mode tauri-qualification",
    "tauri": "node scripts/run-tauri.mjs",
    "tauri:dev": "node scripts/run-tauri.mjs dev",
    "tauri:dev:collab": "node scripts/run-tauri.mjs dev --collab=staging",
    "tauri:build": "node scripts/run-tauri.mjs build",
    "tauri:build:staging": "node scripts/run-tauri.mjs build --collab=staging",
    "tauri:build:prod": "node scripts/run-tauri.mjs build --collab=production",
    "tauri:build:qualification": "node scripts/tauri-build-qualification.mjs",
    "tauri:audit": "node scripts/audit-native-artifacts.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "check:motion": "node scripts/check-motion-budget.mjs",
    "generate:theme": "node scripts/generate-theme-css.mjs",
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:native": "cargo test --workspace",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:list": "playwright test --list",
    "test:e2e:story-1-1": "playwright test --project=chrome --grep \"Story 1.1\"",
    "test:e2e:story-1-2": "playwright test --project=chrome --grep \"Story 1.2\" --retries=0 --headed",
    "pretest:acceptance": "npm run build:spike",
    "test:acceptance": "playwright test --config=playwright.acceptance.config.ts",
    "verify:ci": "node scripts/verify-ci.mjs",
    "verify:ci:full": "node scripts/verify-ci.mjs --full",
    "test:acceptance:list": "playwright test --config=playwright.acceptance.config.ts --list",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:mutation": "stryker run",
    "test:e2e:collab": "playwright test --config=playwright.collab.config.ts",
    "check:app-only": "node scripts/check-app-only.mjs",
    "package:portable": "node scripts/package-portable.mjs",
    "test:portable": "playwright test --config scripts/playwright.portable.config.ts"
  },
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "overrides": {
    "qs": "6.17.1",
    "image-size": "2.0.4",
    "ajv": "8.20.0",
    "tmp": "0.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@faker-js/faker": "10.5.0",
    "@playwright/test": "1.61.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "jszip": "^3.10.1",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vitest": "4.1.12",
    "vite-plugin-pwa": "1.3.0"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@tanstack/react-virtual": "3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "chrono-node": "2.10.1",
    "docx": "9.7.1",
    "pptxgenjs": "^4.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "temporal-polyfill": "1.0.2",
    "uuid": "14.0.1"
  }
}
